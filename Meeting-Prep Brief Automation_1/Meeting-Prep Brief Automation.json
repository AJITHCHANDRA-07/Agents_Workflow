        "limit": 20,
        "options": {}
      },
      "id": "3f8deb87-83df-4c6e-979c-a003fd8762ec",
      "name": "Get Upcoming Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -1536,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-has-attendees",
              "leftValue": "={{ $json.attendees ? $json.attendees.length : 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cc142e87-e59e-47e1-b0be-3a0ebe070f52",
      "name": "Has External Attendee?",
