      "typeVersion": 2.2,
      "position": [
        -1328,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "meetingTitle",
              "type": "string",
              "value": "={{ $json.summary }}"
            },
            {
              "id": "a2",
              "name": "meetingTime",
              "type": "string",
              "value": "={{ $json.start.dateTime }}"
            },
            {
              "id": "a3",
              "name": "attendeeEmail",
              "type": "string",
              "value": "={{ $json.attendees[0].email }}"
            },
            {
              "id": "a4",
              "name": "meetingDescription",
              "type": "string",
              "value": "={{ $json.description || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "067cc722-39cb-45cb-83a8-8a175d5294e2",
      "name": "Extract Meeting Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1104,
        80
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 3,
        "filters": {
          "q": "=from:{{ $json.attendeeEmail }} OR to:{{ $json.attendeeEmail }}"
        }
      },
      "id": "a448ee17-ec89-4c6c-bb66-85b963312ce6",
      "name": "Search Gmail History",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -880,
        80
      ],
      "webhookId": "1b96fa5b-8da7-4fc5-8a5a-3868cdc7232d"
    },
    {
      "parameters": {
        "jsCode": "// Combine up to 3 email snippets into one context block\nconst items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{ json: { emailContext: 'No prior email history found with this contact.' } }];\n}\n\nlet combined = '';\nitems.forEach((item, i) => {\n  const subject = item.json.subject || '(no subject)';\n  const snippet = item.json.snippet || item.json.textPlain || '';\n  combined += `Email ${i + 1} - Subject: ${subject}\\n${snippet}\\n\\n`;\n});\n\nreturn [{ json: { emailContext: combined } }];"
      },
      "id": "9fbf8410-46fe-4fe6-890a-2fa7707e9cfc",
      "name": "Combine Email Snippets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are helping a founder prepare for a meeting.\\n\\nMeeting: {{ $('Extract Meeting Fields').item.json.meetingTitle }}\\nTime: {{ $('Extract Meeting Fields').item.json.meetingTime }}\\nAttendee: {{ $('Extract Meeting Fields').item.json.attendeeEmail }}\\nDescription: {{ $('Extract Meeting Fields').item.json.meetingDescription }}\\n\\nRecent email history:\\n{{ $json.emailContext }}\\n\\nWrite a brief under 5 lines: who this is, what was last discussed, and 2 suggested talking points for today's meeting. If there is no email history, suggest 2 good opening questions instead.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "d9eff10e-452f-4cf2-b736-8f9afe289878",
      "name": "Generate Brief (Groq LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -448,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "finalMessage",
              "type": "string",
              "value": "=📅 Meeting in 30 min: {{ $('Extract Meeting Fields').item.json.meetingTitle }}\n\n{{ $json.choices[0].message.content }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3c9bd034-b369-4a5a-9a19-ca0e9be2bc22",
      "name": "Format Final Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -224,
        80
      ]
    },
    {
      "parameters": {
        "select": "user",
        "user": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_YOUR_SLACK_USER_ID"
        },
        "text": "={{ $json.finalMessage }}",
        "otherOptions": {}
      },
      "id": "4c3ebd09-aad1-4794-a996-deb51881ef2b",
